[Unit]
Description=API Catering
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/catering-api
EnvironmentFile=/home/pi/catering-api/.env
ExecStart=/home/pi/catering-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
